#cloud-config
package_update: true
package_upgrade: true

write_files:
  - path: /etc/systemd/system/ollama.service.d/override.conf
    permissions: '0644'
    content: |
      [Service]
      Environment="OLLAMA_HOST=127.0.0.1:11434"

  - path: /usr/local/bin/ollama-first-boot.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      # cloud-init's runcmd executes with no $HOME set, and the ollama CLI
      # panics ("$HOME is not defined") during its own init if it's missing -
      # this only affects the client invocations below, not the systemd
      # service (which gets its environment from the unit file, not a shell).
      export HOME=/root

      echo "== Waiting for the Ollama API socket =="
      for i in $(seq 1 60); do
        curl -sf http://127.0.0.1:11434/api/version >/dev/null && break
        sleep 2
      done

      echo "== Pulling ${ollama_model} =="
      ollama pull ${ollama_model}

      echo "== Smoke test (latency/throughput visible below) =="
      ollama run ${ollama_model} --verbose "1+1" || true

runcmd:
  - curl -fsSL https://ollama.com/install.sh | sh
  - systemctl daemon-reload
  - systemctl enable --now ollama
  - /usr/local/bin/ollama-first-boot.sh
