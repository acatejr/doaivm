#cloud-config
package_update: true
package_upgrade: true

write_files:
  - path: /etc/systemd/system/ollama.service.d/override.conf
    permissions: '0644'
    content: |
      [Service]
      Environment="OLLAMA_MODELS=/opt/ollama-models"
      Environment="OLLAMA_HOST=127.0.0.1:11434"
      Environment="OLLAMA_NUM_THREAD=${ollama_num_thread}"
      Environment="OLLAMA_CONTEXT_LENGTH=${ollama_num_ctx}"

  - path: /usr/local/bin/ollama-first-boot.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      # cloud-init's runcmd executes with no $HOME set, and the ollama CLI
      # panics ("$HOME is not defined") during its own init if it's missing -
      # this only affects the client invocations below, not the systemd
      # service (which gets its environment from the unit file, not a shell).
      export HOME=/root

      echo "== Waiting for the Ollama API socket =="
      for i in $(seq 1 60); do
        curl -sf http://127.0.0.1:11434/api/version >/dev/null && break
        sleep 2
      done

      echo "== Pulling ${ollama_model} =="
      ollama pull ${ollama_model}

      echo "== Smoke test (latency/throughput visible below) =="
      ollama run ${ollama_model} --verbose "1+1" || true

runcmd:
  - curl -fsSL https://ollama.com/install.sh | sh
  # The installer above creates the unprivileged "ollama" system user and a
  # systemd unit that runs the daemon as that user (User=ollama Group=ollama).
  # The models directory must exist AND be owned by that user before the
  # service starts, or it fails to initialize its model store and crash-loops.
  - mkdir -p /opt/ollama-models
  - chown ollama:ollama /opt/ollama-models
  - systemctl daemon-reload
  - systemctl enable --now ollama
  - /usr/local/bin/ollama-first-boot.sh
