# Copy to terraform.tfvars and fill in, or set DIGITALOCEAN_TOKEN / TF_VAR_do_token
# in your shell instead of putting the token in a file.

# do_token = ""

ssh_allowed_ips = ["203.0.113.4/32"]

# Default droplet_size is back to "gpu-l40sx1-48gb" (L40S) in region "tor1" -
# GPU availability flips between L40S and RTX 6000 Ada over time (confirmed
# live 2026-09-17). Re-verify before every apply:
# droplet_size = "gpu-l40sx1-48gb" # `doctl compute size list`
# image        = ""                 # `doctl compute image list --public`
